{
  "name": "yekora",
  "private": true,
  "workspaces": [
    "apps/api"
  ],
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "next dev",
    "build": "bun scripts/buildCatalog.ts && next build && bun scripts/pruneCatalogPlaceholder.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:tsdoc": "bun scripts/checkTsDocCoverage.ts",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:frontend": "vitest run --config vitest.frontend.config.ts",
    "test:backend": "vitest run --config vitest.backend.config.ts --coverage",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test --config=playwright.local.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "4.1.12",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^15.2.11",
    "mysql2": "^3.24.6",
    "postcss": "^8.5.31",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vitest": "4.1.12",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "tinypool": "^2.1.2",
    "postcss": "^8.5.31"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue,css,md,json}": "prettier --write",
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
