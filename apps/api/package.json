{
  "name": "@yekora/api",
  "private": true,
  "type": "module",
  "version": "0.4.0",
  "description": "YĒKORA catalog API (FC 008): Fastify on Node 24, MariaDB with hand-written parameterized SQL, no ORM.",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js --packages=external",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "esbuild": "^0.25"
  },
  "dependencies": {
    "@fastify/cors": "^11",
    "@fastify/helmet": "^13",
    "@fastify/rate-limit": "^11",
    "fastify": "^5",
    "mysql2": "^3",
    "zod": "^3"
  }
}
