# YĒKORA · static site rules (FC 003, Amendment 1).
# Spanish lives at the root and English under /en/: the URL alone decides the language,
# so there is no redirect by cookie or by browser language.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Preventive: the earlier /es-MX/ prefix moved to the root.
RewriteRule ^es-MX/?(.*)$ /$1 [R=301,L]

# Account area (FC 028 T2.6c, ADR 0011): one client-rendered page per language. Any sub-path that
# is not a real file (an order, the panel) is answered by that area's own index.html, never the
# home page, and the page opens the view the path names.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^cuenta/. /cuenta/index.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^en/account/. /en/account/index.html [L]

# PWA (FC 007): the manifest needs its own MIME type, and the service worker and manifest must
# never be cached by HTTP, so a new deploy (new SHA inside sw.js) reaches browsers right away.
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Content Security Policy (FC 008, OWASP A05), on every answer including the 404 page.
  # Everything is served from this origin; the only other origin is the catalog API. Next.js
  # inlines its bootstrap scripts and styles in the static export, hence 'unsafe-inline'.
  # scripts/serveStatic.ts reads this exact line, so the local E2E runs under the same policy.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://apiv1.yekora.mx; font-src 'self'; connect-src 'self' https://apiv1.yekora.mx; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

  # Transport and browser hardening (FC 010, OWASP A02/A05), also on every answer.
  # HTTP → HTTPS is already a 301 at Hostinger's CDN, in front of Apache, so there is no rewrite
  # here: behind that proxy Apache may not see HTTPS and could loop, and the CI httpd is plain
  # HTTP. HSTS is sent over HTTPS only by browsers' rules; no `preload` until Ω authorizes it.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
